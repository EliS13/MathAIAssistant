{
  "manifest_version": 3,
  "name": "Marking Feedback Assistant",
  "version": "1.5.0",
  "description": "Saves a Classroom submission's files, runs your marking code on them, and shows the feedback PDFs.",
  "key": "",
  "action": {
    "default_title": "Open the marking assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://classroom.google.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ]
}
